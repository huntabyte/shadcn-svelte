{
	"name": "@shadcn-svelte/monorepo",
	"version": "0.0.1",
	"description": "monorepo for shadcn-svelte",
	"author": {
		"name": "huntabyte",
		"url": "https://twitter.com/huntabyte"
	},
	"private": true,
	"scripts": {
		"build": "pnpm build:docs",
		"build:cli": "pnpm -r -F \"./packages/*\" -F \"./sv-addons/*\" build",
		"build:docs": "pnpm -F docs build",
		"dev": "concurrently -n packages,apps --kill-others=false -c \"blue,green\" \"pnpm -r -parallel -F './packages/**' dev\" \"wait-on packages/cli/dist/index.mjs && pnpm -r -parallel -F docs dev\"",
		"dev:cli": "pnpm -F  \"./packages/**\" --parallel --reporter append-only --color dev",
		"preview": "pnpm -F docs preview",
		"test": "pnpm --color --reporter append-only -F \"./packages/*\" -F \"./sv-addons/*\" test",
		"check": "pnpm --parallel check",
		"lint": "oxfmt --check && eslint . --no-config-lookup --config eslint.config.js",
		"format": "oxfmt",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "pnpm build:cli && pnpm -r sync",
		"ci:publish": "changeset publish",
		"ci:build": "pnpm build:cli",
		"ci:release": "pnpm ci:build && pnpm ci:publish"
	},
	"engines": {
		"pnpm": ">=9",
		"node": ">=20"
	},
	"packageManager": "pnpm@10.32.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/huntabyte/shadcn-svelte.git"
	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@types/node": "^26.6.4",
		"concurrently": "^10.0.5",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"minimatch": "^10.2.6",
		"oxfmt": "^0.71.0",
		"pretty-quick": "^4.2.2",
		"rimraf": "^6.1.3",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.71.0",
		"wait-on": "^9.5.1",
		"wrangler": "^4.147.0"
	}
}
