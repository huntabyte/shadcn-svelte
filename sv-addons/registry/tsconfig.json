{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts", "tsdown.config.ts", "vitest.config.ts"]
}
