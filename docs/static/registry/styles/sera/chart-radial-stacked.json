{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "chart-radial-stacked",
	"type": "registry:block",
	"devDependencies": [
		"@lucide/svelte@^1.27.0",
		"layerchart@2.9.2"
	],
	"registryDependencies": [
		"card",
		"chart"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport TrendingUpIcon from \"@lucide/svelte/icons/trending-up\";\n\timport { ArcChart, Text } from \"layerchart\";\n\timport * as Card from \"$UI$/card/index.js\";\n\timport * as Chart from \"$UI$/chart/index.js\";\n\n\tconst chartData = [{ month: \"january\", desktop: 1260, mobile: 570 }];\n\n\tconst chartConfig = {\n\t\tdesktop: { label: \"Desktop\", color: \"var(--chart-1)\" },\n\t\tmobile: { label: \"Mobile\", color: \"var(--chart-2)\" },\n\t} satisfies Chart.ChartConfig;\n\tconst totalVisitors = chartData[0].desktop + chartData[0].mobile;\n\tconst mobileEndAngle = 90 - (chartData[0].mobile / totalVisitors) * 180;\n</script>\n\n<Card.Root class=\"flex flex-col\">\n\t<Card.Header class=\"items-center pb-0\">\n\t\t<Card.Title>Radial Chart - Stacked</Card.Title>\n\t\t<Card.Description>January - June 2024</Card.Description>\n\t</Card.Header>\n\t<Card.Content class=\"flex flex-1 items-center pb-0\">\n\t\t<Chart.Container config={chartConfig} class=\"mx-auto aspect-square w-full max-w-[250px]\">\n\t\t\t<ArcChart\n\t\t\t\tkey=\"platform\"\n\t\t\t\tlabel=\"platform\"\n\t\t\t\tvalue=\"visitors\"\n\t\t\t\tinnerRadius={83}\n\t\t\t\touterRadius={107}\n\t\t\t\tpadding={0}\n\t\t\t\trange={[90, -90]}\n\t\t\t\tseries={[\n\t\t\t\t\t{\n\t\t\t\t\t\tkey: \"mobile\",\n\t\t\t\t\t\tcolor: chartConfig.mobile.color,\n\t\t\t\t\t\tdata: [{ platform: \"mobile\", visitors: chartData[0].mobile }],\n\t\t\t\t\t\tprops: {\n\t\t\t\t\t\t\tdomain: [0, chartData[0].mobile],\n\t\t\t\t\t\t\trange: [90, mobileEndAngle],\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t\t{\n\t\t\t\t\t\tkey: \"desktop\",\n\t\t\t\t\t\tcolor: chartConfig.desktop.color,\n\t\t\t\t\t\tdata: [{ platform: \"desktop\", visitors: chartData[0].desktop }],\n\t\t\t\t\t\tprops: {\n\t\t\t\t\t\t\tdomain: [0, chartData[0].desktop],\n\t\t\t\t\t\t\trange: [mobileEndAngle, -90],\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t]}\n\t\t\t\tcornerRadius={5}\n\t\t\t\tprops={{\n\t\t\t\t\tarc: {\n\t\t\t\t\t\ttrack: false,\n\t\t\t\t\t\tstroke: \"transparent\",\n\t\t\t\t\t\tstrokeWidth: 2,\n\t\t\t\t\t\tmotion: Chart.defaultMotion,\n\t\t\t\t\t},\n\t\t\t\t}}\n\t\t\t>\n\t\t\t\t{#snippet aboveMarks()}\n\t\t\t\t\t<Text\n\t\t\t\t\t\tvalue={totalVisitors.toLocaleString()}\n\t\t\t\t\t\ttextAnchor=\"middle\"\n\t\t\t\t\t\tverticalAnchor=\"middle\"\n\t\t\t\t\t\tclass=\"fill-foreground text-2xl! font-bold\"\n\t\t\t\t\t\tdy={-24}\n\t\t\t\t\t/>\n\t\t\t\t\t<Text\n\t\t\t\t\t\tvalue=\"Visitors\"\n\t\t\t\t\t\ttextAnchor=\"middle\"\n\t\t\t\t\t\tverticalAnchor=\"middle\"\n\t\t\t\t\t\tclass=\"fill-muted-foreground! text-muted-foreground\"\n\t\t\t\t\t\tdy={-4}\n\t\t\t\t\t/>\n\t\t\t\t{/snippet}\n\t\t\t\t{#snippet tooltip()}\n\t\t\t\t\t<Chart.Tooltip hideLabel />\n\t\t\t\t{/snippet}\n\t\t\t</ArcChart>\n\t\t</Chart.Container>\n\t</Card.Content>\n\t<Card.Footer class=\"flex-col gap-2 text-sm\">\n\t\t<div class=\"flex items-center gap-2 leading-none font-medium\">\n\t\t\tTrending up by 5.2% this month <TrendingUpIcon class=\"h-4 w-4\" />\n\t\t</div>\n\t\t<div class=\"leading-none text-muted-foreground\">\n\t\t\tShowing total visitors for the last 6 months\n\t\t</div>\n\t</Card.Footer>\n</Card.Root>\n",
			"type": "registry:component",
			"target": "chart-radial-stacked.svelte"
		}
	]
}