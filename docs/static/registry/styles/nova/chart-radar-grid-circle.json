{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "chart-radar-grid-circle",
	"type": "registry:block",
	"devDependencies": [
		"@lucide/svelte@^1.27.0",
		"d3-scale@^4.0.2",
		"@types/d3-scale@^4.0.9",
		"d3-shape@^3.2.0",
		"@types/d3-shape@^3.1.8",
		"layerchart@2.9.2"
	],
	"registryDependencies": [
		"card",
		"chart"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport TrendingUpIcon from \"@lucide/svelte/icons/trending-up\";\n\timport { scaleBand } from \"d3-scale\";\n\timport { curveLinearClosed } from \"d3-shape\";\n\timport { Circle, LineChart, Points, Spline } from \"layerchart\";\n\timport * as Card from \"$UI$/card/index.js\";\n\timport * as Chart from \"$UI$/chart/index.js\";\n\n\tconst chartData = [\n\t\t{ month: \"January\", desktop: 186 },\n\t\t{ month: \"February\", desktop: 305 },\n\t\t{ month: \"March\", desktop: 237 },\n\t\t{ month: \"April\", desktop: 273 },\n\t\t{ month: \"May\", desktop: 209 },\n\t\t{ month: \"June\", desktop: 214 },\n\t];\n\n\tconst chartConfig = {\n\t\tdesktop: { label: \"Desktop\", color: \"var(--chart-1)\" },\n\t} satisfies Chart.ChartConfig;\n\tconst radarScale = Chart.createRevealAnimation();\n</script>\n\n<Card.Root>\n\t<Card.Header class=\"items-center pb-4\">\n\t\t<Card.Title>Radar Chart - Grid Circle</Card.Title>\n\t\t<Card.Description>Showing total visitors for the last 6 months</Card.Description>\n\t</Card.Header>\n\t<Card.Content class=\"pb-0\">\n\t\t<Chart.Container config={chartConfig} class=\"mx-auto aspect-square max-h-[250px]\">\n\t\t\t<LineChart\n\t\t\t\tdata={chartData}\n\t\t\t\tseries={[\n\t\t\t\t\t{\n\t\t\t\t\t\tkey: \"desktop\",\n\t\t\t\t\t\tlabel: \"Desktop\",\n\t\t\t\t\t\tcolor: chartConfig.desktop.color,\n\t\t\t\t\t},\n\t\t\t\t]}\n\t\t\t\tradial\n\t\t\t\tx=\"month\"\n\t\t\t\ty=\"desktop\"\n\t\t\t\txScale={scaleBand()}\n\t\t\t\tpadding={12}\n\t\t\t\tprops={{\n\t\t\t\t\txAxis: {\n\t\t\t\t\t\ttickLength: 0,\n\t\t\t\t\t},\n\t\t\t\t\tyAxis: {\n\t\t\t\t\t\tformat: () => \"\",\n\t\t\t\t\t},\n\t\t\t\t\tgrid: {\n\t\t\t\t\t\tradialY: \"circle\",\n\t\t\t\t\t},\n\t\t\t\t\ttooltip: {\n\t\t\t\t\t\tcontext: {\n\t\t\t\t\t\t\tmode: \"voronoi\",\n\t\t\t\t\t\t\tradius: 250,\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t\thighlight: {\n\t\t\t\t\t\tlines: false,\n\t\t\t\t\t\tpoints: false,\n\t\t\t\t\t},\n\t\t\t\t}}\n\t\t\t>\n\t\t\t\t{#snippet marks({ context })}\n\t\t\t\t\t{#each context.series.visibleSeries as series (series.key)}\n\t\t\t\t\t\t<g transform={`scale(${radarScale.current})`}>\n\t\t\t\t\t\t\t<Spline\n\t\t\t\t\t\t\t\tseriesKey={series.key}\n\t\t\t\t\t\t\t\tcurve={curveLinearClosed}\n\t\t\t\t\t\t\t\tfill={series.color}\n\t\t\t\t\t\t\t\tfillOpacity={0.6}\n\t\t\t\t\t\t\t\tstroke=\"none\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t</g>\n\t\t\t\t\t\t<Points seriesKey={series.key}>\n\t\t\t\t\t\t\t{#snippet children({ points })}\n\t\t\t\t\t\t\t\t{#each points as point, i (i)}\n\t\t\t\t\t\t\t\t\t<Circle\n\t\t\t\t\t\t\t\t\t\tcx={point.x * radarScale.current}\n\t\t\t\t\t\t\t\t\t\tcy={point.y * radarScale.current}\n\t\t\t\t\t\t\t\t\t\tr={4}\n\t\t\t\t\t\t\t\t\t\tfill={series.color}\n\t\t\t\t\t\t\t\t\t\tclass=\"lc-point\"\n\t\t\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t</Points>\n\t\t\t\t\t{/each}\n\t\t\t\t{/snippet}\n\t\t\t\t{#snippet tooltip()}\n\t\t\t\t\t<Chart.Tooltip />\n\t\t\t\t{/snippet}\n\t\t\t</LineChart>\n\t\t</Chart.Container>\n\t</Card.Content>\n\t<Card.Footer class=\"flex-col gap-2 text-sm\">\n\t\t<div class=\"flex items-center gap-2 leading-none font-medium\">\n\t\t\tTrending up by 5.2% this month <TrendingUpIcon class=\"h-4 w-4\" />\n\t\t</div>\n\t\t<div class=\"flex items-center gap-2 leading-none text-muted-foreground\">\n\t\t\tJanuary - June 2024\n\t\t</div>\n\t</Card.Footer>\n</Card.Root>\n",
			"type": "registry:component",
			"target": "chart-radar-grid-circle.svelte"
		}
	]
}