			"content": "<script lang=\"ts\" module>\n\timport { type VariantProps, tv } from \"tailwind-variants\";\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAnchorAttributes, HTMLButtonAttributes } from \"svelte/elements\";\n\n\texport const buttonVariants = tv({\n\t\tbase: \"focus-visible:border-ring focus-visible:ring-ring aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 rounded-[6px] border border-transparent bg-clip-padding text-[13px]/[18px] font-medium focus-visible:ring-2 aria-invalid:ring-2 [&_svg:not([class*='size-'])]:size-4 group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0\",\n\t\tvariants: {\n\t\t\tvariant: {\n\t\t\t\tdefault: \"bg-primary text-primary-foreground hover:bg-[color-mix(in_srgb,var(--primary),var(--foreground)_10%)] aria-expanded:bg-[color-mix(in_srgb,var(--primary),var(--foreground)_10%)]\",\n\t\t\t\toutline: \"border-(--ledger-field-border) shadow-(--ledger-field-shadow) bg-background text-foreground hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground\",\n\t\t\t\tsecondary: \"border-(--ledger-field-border) shadow-(--ledger-field-shadow) bg-secondary text-secondary-foreground hover:bg-[color-mix(in_srgb,var(--secondary),var(--foreground)_6%)] aria-expanded:bg-secondary aria-expanded:text-secondary-foreground\",\n\t\t\t\tghost: \"text-foreground hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground\",\n\t\t\t\tdestructive: \"bg-[var(--ledger-chip-red-bg)] text-[var(--ledger-chip-red-ink)] hover:bg-[color-mix(in_srgb,var(--ledger-chip-red-bg),var(--ledger-chip-red-ink)_10%)] focus-visible:ring-destructive focus-visible:border-destructive\",\n\t\t\t\tlink: \"text-foreground underline-offset-4 hover:underline\",\n\t\t\t},\n\t\t\tsize: {\n\t\t\t\tdefault: \"h-7 gap-1 px-2 text-[13px]/[18px] has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3.5\",\n\t\t\t\txs: \"h-5 gap-1 rounded-[4px] px-2 text-[11px] has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-2.5\",\n\t\t\t\tsm: \"h-6 gap-1 px-2 text-[13px]/[18px] has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5 [&_svg:not([class*='size-'])]:size-3\",\n\t\t\t\tlg: \"h-8 gap-1 px-2.5 text-[13px]/[18px] has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 [&_svg:not([class*='size-'])]:size-4\",\n\t\t\t\ticon: \"size-7 [&_svg:not([class*='size-'])]:size-3.5 data-[variant=outline]:border-input data-[variant=secondary]:border-transparent data-[variant=outline]:shadow-none data-[variant=secondary]:shadow-none data-[variant=outline]:focus-visible:border-ring data-[variant=secondary]:focus-visible:border-ring data-[variant=outline]:aria-invalid:border-destructive dark:data-[variant=outline]:aria-invalid:border-destructive/50 data-[variant=secondary]:aria-invalid:border-destructive dark:data-[variant=secondary]:aria-invalid:border-destructive/50\",\n\t\t\t\t\"icon-xs\": \"size-5 rounded-[4px] [&_svg:not([class*='size-'])]:size-2.5 data-[variant=outline]:border-input data-[variant=secondary]:border-transparent data-[variant=outline]:shadow-none data-[variant=secondary]:shadow-none data-[variant=outline]:focus-visible:border-ring data-[variant=secondary]:focus-visible:border-ring data-[variant=outline]:aria-invalid:border-destructive dark:data-[variant=outline]:aria-invalid:border-destructive/50 data-[variant=secondary]:aria-invalid:border-destructive dark:data-[variant=secondary]:aria-invalid:border-destructive/50\",\n\t\t\t\t\"icon-sm\": \"size-6 [&_svg:not([class*='size-'])]:size-3 data-[variant=outline]:border-input data-[variant=secondary]:border-transparent data-[variant=outline]:shadow-none data-[variant=secondary]:shadow-none data-[variant=outline]:focus-visible:border-ring data-[variant=secondary]:focus-visible:border-ring data-[variant=outline]:aria-invalid:border-destructive dark:data-[variant=outline]:aria-invalid:border-destructive/50 data-[variant=secondary]:aria-invalid:border-destructive dark:data-[variant=secondary]:aria-invalid:border-destructive/50\",\n\t\t\t\t\"icon-lg\": \"size-8 [&_svg:not([class*='size-'])]:size-4 data-[variant=outline]:border-input data-[variant=secondary]:border-transparent data-[variant=outline]:shadow-none data-[variant=secondary]:shadow-none data-[variant=outline]:focus-visible:border-ring data-[variant=secondary]:focus-visible:border-ring data-[variant=outline]:aria-invalid:border-destructive dark:data-[variant=outline]:aria-invalid:border-destructive/50 data-[variant=secondary]:aria-invalid:border-destructive dark:data-[variant=secondary]:aria-invalid:border-destructive/50\",\n\t\t\t},\n\t\t},\n\t\tdefaultVariants: {\n\t\t\tvariant: \"default\",\n\t\t\tsize: \"default\",\n\t\t},\n\t});\n\n\texport type ButtonVariant = VariantProps<typeof buttonVariants>[\"variant\"];\n\texport type ButtonSize = VariantProps<typeof buttonVariants>[\"size\"];\n\n\texport type ButtonProps = WithElementRef<HTMLButtonAttributes> &\n\t\tWithElementRef<HTMLAnchorAttributes> & {\n\t\t\tvariant?: ButtonVariant;\n\t\t\tsize?: ButtonSize;\n\t\t};\n</script>\n\n<script lang=\"ts\">\n\tlet {\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tsize = \"default\",\n\t\tref = $bindable(null),\n\t\thref = undefined,\n\t\ttype = \"button\",\n\t\tdisabled,\n\t\tchildren,\n\t\t...restProps\n\t}: ButtonProps = $props();\n</script>\n\n{#if href}\n\t<a\n\t\tbind:this={ref}\n\t\tdata-slot=\"button\"\n\t\tclass={cn(buttonVariants({ variant, size }), className)}\n\t\thref={disabled ? undefined : href}\n\t\taria-disabled={disabled}\n\t\trole={disabled ? \"link\" : undefined}\n\t\ttabindex={disabled ? -1 : undefined}\n\t\t{...restProps}\n\t>\n\t\t{@render children?.()}\n\t</a>\n{:else}\n\t<button\n\t\tbind:this={ref}\n\t\tdata-slot=\"button\"\n\t\tclass={cn(buttonVariants({ variant, size }), className)}\n\t\t{type}\n\t\t{disabled}\n\t\t{...restProps}\n\t>\n\t\t{@render children?.()}\n\t</button>\n{/if}\n",
