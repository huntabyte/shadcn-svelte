{
	"name": "docs",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --reporter append-only --color \"/dev:/\"",
		"dev:content": "velite dev --watch",
		"dev:icons": "tsx scripts/build-icons.ts --watch",
		"dev:svelte": "vite dev",
		"build": "concurrently \"pnpm build:icons\" \"pnpm build:content\" \"pnpm build:llm-placeholders\" && pnpm build:svelte && pnpm build:llms",
		"build:content": "velite && tsx scripts/velite/velite-update-json.ts",
		"build:svelte": "vite build",
		"build:registry": "tsx scripts/build-registry.ts build-registry",
		"build:screenshots": "tsx scripts/capture-registry.ts",
		"build:icons": "tsx scripts/build-icons.ts",
		"build:llms": "tsx scripts/build-llms.ts",
		"build:llm-placeholders": "tsx scripts/build-llm-placeholders.ts",
		"pull:styles": "tsx scripts/pull-styles.ts",
		"replace:velite": "tsx scripts/velite/velite-watch-output.ts",
		"sync": "pnpm build:registry && pnpm build:content && svelte-kit sync",
		"preview": "vite preview",
		"check": "svelte-check --fail-on-warnings --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261005.1",
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/collision": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/lora": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/merriweather": "^5.3.0",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource-variable/noto-serif": "^5.3.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@fontsource-variable/oxanium": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@fontsource-variable/raleway": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource-variable/roboto-slab": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.52.0",
		"@prettier/sync": "0.6.1",
		"@shikijs/langs": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tabler/icons-svelte": "^3.48.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^9.2.6",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/hast": "^3.0.5",
		"@types/jsdom": "^30.0.0",
		"@types/lodash": "^4.17.25",
		"@types/lodash.template": "^4.5.3",
		"@types/mdast": "^4.0.4",
		"@types/qrcode": "^1.5.6",
		"acorn": "^8.18.0",
		"bits-ui": "^2.19.5",
		"chrono-node": "^2.10.2",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"consola": "^3.4.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"estree-walker": "^3.0.3",
		"formsnap": "^2.0.1",
		"globby": "^16.2.4",
		"hast-util-to-html": "^9.0.5",
		"jsdom": "^30.1.2",
		"layerchart": "^2.5.1",
		"little-date": "^1.2.1",
		"lodash": "^4.18.1",
		"magic-string": "^1.4.3",
		"mdsx": "^0.0.7",
		"mode-watcher": "^1.1.0",
		"package-manager-detector": "^1.9.0",
		"paneforge": "^1.0.2",
		"phosphor-svelte": "^3.1.0",
		"postcss": "^8.5.28",
		"prettier-plugin-svelte": "^4.1.1",
		"qrcode": "^1.5.4",
		"rehype-parse": "^9.0.1",
		"rehype-pretty-code": "^0.14.5",
		"rehype-remark": "^10.0.1",
		"rehype-slug": "^6.0.0",
		"remark-code-import": "^1.2.0",
		"remark-gfm": "^4.0.1",
		"remark-stringify": "^11.0.0",
		"remixicon-svelte": "^0.0.5",
		"rollup-plugin-visualizer": "^7.1.1",
		"runed": "^0.37.1",
		"shadcn-svelte": "workspace:*",
		"shiki": "^4.5.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "^1.2.1",
		"svelte-toolbelt": "^0.10.6",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"unist-builder": "^4.0.0",
		"unist-util-visit": "^5.1.0",
		"vaul-svelte": "1.0.0-next.7",
		"velite": "^0.4.0",
		"vite": "^8.3.2",
		"zod": "catalog:"
	}
}
