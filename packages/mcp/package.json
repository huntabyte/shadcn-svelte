{
	"name": "@shadcn-svelte/mcp",
	"version": "0.0.0",
	"description": "MCP server for shadcn-svelte.",
	"license": "MIT",
	"author": {
		"name": "huntabyte & CokaKoala",
		"url": "https://twitter.com/huntabyte"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/huntabyte/shadcn-svelte.git",
		"directory": "packages/mcp"
	},
	"homepage": "https://shadcn-svelte.com",
	"bugs": {
		"url": "https://github.com/huntabyte/shadcn-svelte/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"shadcn-sv-mcp": "./dist/index.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"mcp",
		"shadcn",
		"svelte",
		"shadcn-svelte"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown --minify",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.32.0",
		"package-manager-detector": "^1.2.0",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	}
}
