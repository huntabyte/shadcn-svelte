{
	"name": "@shadcn/svelte",
	"version": "0.0.0",
	"description": "Unstyled components for Svelte.",
	"license": "MIT",
	"author": {
		"name": "huntabyte",
		"url": "https://twitter.com/huntabyte"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/huntabyte/shadcn-svelte.git",
		"directory": "packages/svelte"
	},
	"homepage": "https://shadcn-svelte.com",
	"bugs": {
		"url": "https://github.com/huntabyte/shadcn-svelte/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"keywords": [
		"svelte",
		"headless",
		"unstyled",
		"primitives",
		"accessible",
		"ui",
		"shadcn"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./questionnaire": {
			"types": "./dist/questionnaire/index.d.ts",
			"svelte": "./dist/questionnaire/index.js",
			"default": "./dist/questionnaire/index.js"
		},
		"./message-scroller": {
			"types": "./dist/message-scroller/index.d.ts",
			"svelte": "./dist/message-scroller/index.js",
			"default": "./dist/message-scroller/index.js"
		}
	},
	"scripts": {
		"dev": "pnpm watch",
		"build": "pnpm package",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:browser": "vitest run -c vitest.browser.config.ts",
		"watch": "svelte-package --watch",
		"clean": "rimraf dist .svelte-kit"
	},
	"peerDependencies": {
		"svelte": "^5.33.0"
	},
	"dependencies": {
		"esm-env": "^1.1.2",
		"runed": "^0.37.1",
		"svelte-toolbelt": "^0.10.6"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "2.5.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@vitest/browser": "^3.2.6",
		"jsdom": "^28.1.0",
		"playwright": "^1.61.0",
		"publint": "^0.2.12",
		"rimraf": "^6.1.3",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "^3.2.6"
	}
}
