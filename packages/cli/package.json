{
	"name": "shadcn-svelte",
	"version": "1.5.0",
	"description": "Add components to your apps.",
	"license": "MIT",
	"author": {
		"name": "huntabyte & CokaKoala",
		"url": "https://twitter.com/huntabyte"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/huntabyte/shadcn-svelte.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"bin": "./dist/index.mjs",
	"exports": {
		"./icons": {
			"types": "./dist/icons/index.d.mts",
			"default": "./dist/icons/index.mjs"
		},
		"./preset": {
			"types": "./dist/preset/index.d.mts",
			"default": "./dist/preset/index.mjs"
		},
		"./schema": {
			"types": "./dist/schema/index.d.mts",
			"default": "./dist/schema/index.mjs"
		},
		"./utils/css": {
			"types": "./dist/utils/css.d.mts",
			"default": "./dist/utils/css.mjs"
		},
		"./transformers": {
			"types": "./dist/utils/transformers/index.d.mts",
			"default": "./dist/utils/transformers/index.mjs"
		},
		"./transformers/icons": {
			"types": "./dist/utils/transformers/transform-icons.d.mts",
			"default": "./dist/utils/transformers/transform-icons.mjs"
		},
		"./transformers/imports": {
			"types": "./dist/utils/transformers/transform-imports.d.mts",
			"default": "./dist/utils/transformers/transform-imports.mjs"
		},
		"./transformers/menu": {
			"types": "./dist/utils/transformers/transform-menu.d.mts",
			"default": "./dist/utils/transformers/transform-menu.mjs"
		},
		"./transformers/font": {
			"types": "./dist/utils/transformers/transform-font.d.mts",
			"default": "./dist/utils/transformers/transform-font.mjs"
		},
		"./transformers/strip-types": {
			"types": "./dist/utils/transformers/transform-strip-types.d.mts",
			"default": "./dist/utils/transformers/transform-strip-types.mjs"
		},
		"./tailwind.css": {
			"style": "./dist/tailwind.css"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"components",
		"ui",
		"tailwind",
		"radix-ui",
		"shadcn",
		"svelte",
		"sveltekit",
		"radix-svelte"
	],
	"scripts": {
		"dev": "tsdown --watch --sourcemap",
		"build": "tsdown --minify",
		"check": "tsc --noEmit",
		"start": "node dist/index.mjs",
		"start:dev": "cross-env REGISTRY_URL=http://localhost:5173/registry node dist/index.mjs",
		"start:proxy": "pnpm dlx straightforward@latest --port 9000",
		"test:setup": "pnpm -F @shadcn-svelte/registry demo:clean && pnpm -F @shadcn-svelte/registry demo:create && pnpm -F @shadcn-svelte/registry demo:add:ci && pnpm -F @shadcn-svelte/registry demo:build:registry-template",
		"test": "pnpm test:setup && vitest"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"node-fetch-native": "^1.6.7",
		"postcss": "^8.5.28",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.8.1",
		"@svecosystem/strip-types": "^0.0.5",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"@types/semver": "^7.8.0",
		"acorn": "^8.18.0",
		"cross-env": "^10.1.0",
		"deepmerge": "^4.3.1",
		"empathic": "^2.1.0",
		"estree-walker": "^3.0.3",
		"get-tsconfig": "^4.14.3",
		"ignore": "^7.0.12",
		"magic-string": "^1.4.3",
		"memfs": "^4.80.0",
		"open": "^11.0.4",
		"package-manager-detector": "^1.9.0",
		"picocolors": "^1.1.1",
		"resolve.exports": "^2.0.3",
		"semver": "^7.8.5",
		"sucrase": "^3.35.1",
		"tinyexec": "^1.3.1",
		"tsdown": "catalog:",
		"type-fest": "^5.10.0",
		"typescript": "catalog:",
		"vitest": "^5.0.3",
		"zod": "catalog:"
	}
}
