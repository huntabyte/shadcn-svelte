{
	"name": "@shadcn-svelte/primitives",
	"version": "0.0.0",
	"description": "Unstyled, accessible primitives for Svelte.",
	"license": "MIT",
	"author": {
		"name": "huntabyte & CokaKoala",
		"url": "https://twitter.com/huntabyte"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/huntabyte/shadcn-svelte.git",
		"directory": "packages/primitives"
	},
	"homepage": "https://www.shadcn-svelte.com",
	"bugs": {
		"url": "https://github.com/huntabyte/shadcn-svelte/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
