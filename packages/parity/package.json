{
	"name": "@shadcn-svelte/parity",
	"private": true,
	"version": "0.0.0",
	"description": "Compare shadcn-svelte registry classes against upstream shadcn/ui",
	"type": "module",
	"bin": {
		"parity": "./dist/index.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/compare.d.mts",
			"default": "./dist/compare.mjs"
		},
		"./parity-ignore": {
			"types": "./dist/parity-ignore.d.mts",
			"default": "./dist/parity-ignore.mjs"
		},
		"./inject-style-classes": {
			"types": "./dist/inject-style-classes.d.mts",
			"default": "./dist/inject-style-classes.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsdown --watch --sourcemap",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"parity": "node dist/index.mjs"
	},
	"dependencies": {
		"commander": "^14.0.0",
		"picocolors": "^1.1.1",
		"shadcn-svelte": "workspace:*",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "^4.1.10"
	}
}
